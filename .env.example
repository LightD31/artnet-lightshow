# ArtNet Lightshow — copy to .env and edit. Every value here is optional;
# the defaults are what the server uses when the variable is unset.

# ─── Web server & access control ────────────────────────────────────────────
PORT=3000

# Interface to bind. Defaults to 127.0.0.1 (this machine only). Set to 0.0.0.0
# to reach the UI from a phone or another machine — the server then REFUSES to
# start unless LIGHTSHOW_TOKEN is also set, because that would otherwise expose
# blackout, strobe and Art-Net control to the whole network unauthenticated.
#HOST=0.0.0.0

# Shared access token. Required whenever HOST is not loopback. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Open the UI once at http://<host>:<port>/?token=<value>; the browser stores it.
# The Companion module and browser extension each have a field for the same value.
#LIGHTSHOW_TOKEN=

# Base URL browsers use to reach this server. Only needed behind a reverse
# proxy, or when the OAuth callback must use a hostname rather than HOST:PORT.
#PUBLIC_URL=http://lightshow.local:3000

# ─── Art-Net output ─────────────────────────────────────────────────────────
ARTNET_HOST=2.255.255.255
ARTNET_PORT=6454
ARTNET_UNIVERSE=0

# ─── MIDI ───────────────────────────────────────────────────────────────────
# Exact port names. Unset auto-detects the first device matching /x.?touch/i.
#MIDI_INPUT=X-Touch Compact
#MIDI_OUTPUT=X-Touch Compact

# ─── Playback sources ───────────────────────────────────────────────────────
# PRO DJ LINK (CDJs on the network). Set to 1 to enable at startup.
#PROLINK=1

# Windows now-playing via the OS media session. Enabled on Windows by default;
# set to 0 to disable.
#SMTC=0

# Spotify. Register the proxy callback URL shown at startup in your Spotify
# app dashboard. Both values are required for Spotify to appear as a source.
#SPOTIFY_CLIENT_ID=
#SPOTIFY_CLIENT_SECRET=
# Override the OAuth proxy that relays the Spotify callback to this machine.
#SPOTIFY_PROXY_BASE=https://api.drndvs.fr
# Accept OAuth callbacks whose state parameter is missing or unrecognised.
# Only needed if your proxy strips the state parameter; disables OAuth CSRF
# protection, so leave it unset unless auth genuinely fails without it.
#SPOTIFY_ALLOW_UNVERIFIED_STATE=1

# Deezer ARL cookie — enables exact ISRC-matched audio instead of a yt-dlp
# search. Without it, analysis falls back to yt-dlp.
#DEEZER_ARL=

# ─── Analysis ───────────────────────────────────────────────────────────────
# Ceiling on a single analysis before the worker is considered wedged, killed
# and recycled. Default 600000 (10 minutes).
#ANALYZER_TIMEOUT_MS=600000

# Ceiling on a single track download (yt-dlp) before it is killed. A download
# that never finishes would otherwise leave a track change waiting forever, on
# the previous track's timeline, with no error. Default 300000 (5 minutes).
#DOWNLOAD_TIMEOUT_MS=300000

# Confine "analyze this local file" to one directory tree. Unset allows any
# absolute path, which is fine on a loopback bind and less so once exposed.
#ANALYZE_LOCAL_ROOT=/home/me/Music
