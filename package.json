{
  "name": "artnet-lightshow",
  "version": "1.0.0",
  "description": "ArtNet light show controller for 4x Cameo ROOT PAR 6",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build:client": "node scripts/build-client.js",
    "watch:client": "node scripts/build-client.js --watch",
    "prestart": "npm run build:client",
    "start": "node server.js",
    "dev": "node --watch server.js --no-supervisor",
    "preflight": "node scripts/preflight.js --download-models",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json",
    "gen:analysis-types": "node scripts/gen-analysis-types.ts",
    "test": "node --test",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:e2e": "npm run build:client && playwright test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "compression": "^1.8.2",
    "easymidi": "^3.2.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.5.9",
    "jszip": "^3.10.1",
    "multer": "^2.1.1",
    "node-dtls-client": "^2.0.3",
    "nosleep.js": "^0.12.0",
    "pino": "^10.3.1",
    "preact": "^10.19.3",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "alphatheta-connect": "0.27.0",
    "d-fi-core": "^1.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.4",
    "axe-core": "^4.11.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "preact-render-to-string": "^6.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "ip-address": "^10.7.0",
    "metadata-connect": "1.2.2",
    "onelibrary-connect": "1.1.5"
  }
}
