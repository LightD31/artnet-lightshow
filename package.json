{
  "name": "artnet-lightshow",
  "version": "1.0.0",
  "description": "ArtNet light show controller for 4x Cameo ROOT PAR 6",
  "main": "server.js",
  "scripts": {
    "build:client": "node scripts/build-client.js",
    "watch:client": "node scripts/build-client.js --watch",
    "prestart": "npm run build:client",
    "start": "node --openssl-legacy-provider server.js",
    "dev": "node --openssl-legacy-provider --watch server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test",
    "check": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@preact/signals": "^1.2.3",
    "d-fi-core": "^1.3.5",
    "dotenv": "^17.4.1",
    "easymidi": "^3.2.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.5.9",
    "jszip": "^3.10.1",
    "multer": "^2.1.1",
    "preact": "^10.19.3",
    "prolink-connect": "^0.11.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "esbuild": "^0.20.0",
    "eslint": "^9.39.5"
  },
  "overrides": {
    "better-sqlite3": "^12.0.0",
    "cookie": "^0.7.2",
    "ip-address": "^10.7.0"
  }
}
