node_modules/
companion-module/node_modules/
.env

# Everything the server writes for this installation: operator settings, the
# fixture patch, cues, the MIDI map. The settings hold secrets (Spotify client
# secret, Deezer ARL, access token), so none of it goes in the repo.
config/

cache/
# Audio the real-track harness downloads. Large, and not ours to redistribute.
# Written as a glob rather than `tests/fixtures/` because git cannot re-include
# anything under an excluded *directory*, and the line below needs to.
tests/fixtures/*
# The analysis documents are ours to keep: a few KB of derived measurements
# each, no audio, and the regression tests for the show's judgement read them.
!tests/fixtures/tracks/
__pycache__/

# Generated by `npm run build:client` (runs automatically via prestart).
public/app.bundle.js
public/app.bundle.js.map

# Machine-local Claude Code permissions.
.claude/settings.local.json
