{
  "manifest_version": 3,
  "name": "Lightshow Deezer Bridge",
  "version": "0.2.0",
  "description": "Sends the Deezer web player's current track, position and upcoming queue to the local ArtNet Lightshow server (auto-show sync + prefetch).",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.deezer.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "*://www.deezer.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lightshow-deezer-bridge@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "websiteActivity"
        ]
      }
    }
  }
}
